# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=workorder_db

# Database URL (used by Prisma, constructed from MySQL vars above)
# For Docker: mysql://root:${MYSQL_ROOT_PASSWORD}@mysql:3306/${MYSQL_DATABASE}
# For local dev: mysql://root:password@localhost:3306/workorder_db
DATABASE_URL=mysql://root:rootpassword@localhost:3306/workorder_db

# JWT
JWT_SECRET=your-super-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=8h

# Server
PORT=3000
CLIENT_URL=http://localhost:5173

# Security
BCRYPT_SALT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOCK_DURATION_MINUTES=30
